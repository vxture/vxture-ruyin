{
  "name": "@vxture/ruyin-cli",
  "version": "0.2.0",
  "description": "Ruyin developer CLI: contract lint, product packaging (.ruyinpkg) and the static registry index (docs/40-implementation/10-product-integration-guide.md; ruyin dev lands later).",
  "repository": {
    "type": "git",
    "url": "https://github.com/vxture/vxture-ruyin.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "ruyin": "dist/main.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --experimental-test-coverage --test-coverage-include=\"dist/**/*.js\" --test-coverage-exclude=\"dist/**/*.test.js\" --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95 --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@vxture/ruyin-contract-schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
