{
  "name": "@vxture/ruyin-core",
  "version": "0.2.0",
  "description": "Ruyin Workspace Runtime isomorphic kernel: ports, workspace lifecycle, harness state machine, hash-chained audit (design authority: docs/30-design/10-workspace-runtime.md, 50-harness.md, 60-technical-architecture.md section 6).",
  "repository": {
    "type": "git",
    "url": "https://github.com/vxture/vxture-ruyin.git",
    "directory": "packages/runtime-core"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --experimental-test-coverage --test-coverage-include=\"dist/**/*.js\" --test-coverage-exclude=\"dist/**/*.test.js\" --test-coverage-lines=90 --test-coverage-branches=78 --test-coverage-functions=88 --test dist/core.test.js"
  },
  "dependencies": {
    "@vxture/ruyin-contract-schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
