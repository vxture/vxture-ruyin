# vxture-ruyin environment skeleton.
#
# The desktop client ships ZERO secrets: all client-side configuration is
# public by design (docs/30-design/70-repo-organization.md section 2). The only
# env vars this repo ever needs are development-time ones listed here.
#
# NODE_AUTH_TOKEN - GitHub Packages read token so `pnpm install` can resolve
#                   the @vxture scope (see .npmrc). Set it in your shell, never
#                   write the literal value into any tracked file.
# NODE_AUTH_TOKEN=
#
# Platform integration (all PUBLIC configuration - no secrets by design;
# defaults live in apps/local-host/src/platform.ts):
# RUYIN_ACCOUNTS_ISSUER=https://accounts.vxture.com
# RUYIN_OIDC_CLIENT_ID=ruyin
# RUYIN_PLATFORM_API_BASE=   (entitlements API base; unset = C2 disabled)
# RUYIN_CONSOLE_BASE=https://vxture.com
#
# Distribution (public, no secrets):
# RUYIN_UPDATE_FEED=      (update feed base; unset = stable channel on dl.vxture.com)
# RUYIN_REGISTRY_BASE=    (static product registry base; unset = dl.vxture.com/ruyin/products)
# RUYIN_ALLOW_UNSIGNED_PACKAGES=1     (development only: install unsigned .ruyinpkg)
# RUYIN_ALLOW_UNSIGNED_CONNECTORS=1   (development only: install unsigned connectors)
