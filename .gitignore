# Environment - never commit real secrets
.env
*.env
.env.*
!.env.example
.env.bak.*
.npmrc
# The .npmrc only declares the @vxture GitHub Packages registry and references
# ${NODE_AUTH_TOKEN} (no literal secret). It MUST stay committed so CI
# `pnpm install` can resolve @vxture/* packages. Ignored-then-negated to guard
# against a local `npm login` writing a literal token into it.
!.npmrc

# Runtime data and generated artifacts
data/
backup/
private/
generated/
secrets/*
!secrets/.gitkeep

# TLS / certificates / signing
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx

# Logs
*.log
logs/

# Node / pnpm / build outputs
node_modules/
.pnpm-store/
.npm-cache/
out/
build/
dist/
apps/*/release/
*.tsbuildinfo
.vite/

# Electron packaging outputs
*.exe
*.blockmap
*.ruyinpkg

# Test / coverage
coverage/
.nyc_output/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

.claude/

# Bundled skill layer, pulled at build time from resources/skill-manifest.json (ADR-018)
resources/skills/
resources/tools/
# 随包的 Python 引导件（uv + CPython + 预取缓存），构建时由 seed-uv-cache.mjs 生成
resources/uv/

# playwright-mcp writes accessibility snapshots into its cwd. The fix is that
# nothing runs it with the repo as cwd (pull-tools.mjs probes in a temp dir);
# this line is the second net, not the fix - an ignored stray directory is
# still a stray directory.
.playwright-mcp/
